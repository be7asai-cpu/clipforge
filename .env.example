# ClipForge auth configuration
# Copy to .env and fill in values. Restart server after changes.

PORT=3847
HOST=0.0.0.0

# Public base URL used in OAuth callbacks (must match provider console)
BASE_URL=http://localhost:3847

# Session cookie secret (change in production!)
SESSION_SECRET=zmien-na-dlugi-losowy-ciag

# --- Postgres (Neon / Supabase) — TRWAŁE konta i sesje ---
# Bez tego konta są w pliku users.json i ZNIKAJĄ po redeploy na Render free.
# Neon: https://neon.tech → New Project → Connection string (URI)
# Supabase: https://supabase.com → Project Settings → Database → URI
# Przykład Neon:
# DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
# Przykład Supabase:
# DATABASE_URL=postgresql://postgres.xxx:pass@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
DATABASE_URL=
# DATABASE_SSL=0   # tylko lokalny Postgres bez SSL

# Require login for Studio (true/false). Default: true
AUTH_REQUIRED=true

# --- Google OAuth ---
# Pełna instrukcja: OAUTH-SETUP.md  lub  http://localhost:3847/oauth-setup.html
# 1. https://console.cloud.google.com/apis/credentials
# 2. OAuth consent screen (External) + Test user = Twój Gmail
# 3. Create OAuth 2.0 Client ID (Web application)
# 4. Authorized JavaScript origins:  http://localhost:3847
# 5. Authorized redirect URI:
#    http://localhost:3847/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Facebook Login ---
# 1. https://developers.facebook.com/apps → Create App
# 2. Add product: Facebook Login → Web
# 3. Settings → Basic: App ID + App Secret
# 4. Facebook Login → Settings → Valid OAuth Redirect URI:
#    http://localhost:3847/api/auth/facebook/callback
# 5. Development mode: dodaj siebie w Roles (Admin/Tester)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Optional: set 1 behind HTTPS reverse proxy
# TRUST_PROXY=0
# COOKIE_SECURE=0

# --- E-mail activation (SMTP) ---
# Without SMTP, activation links go to data/auth/outbox/ + server console
# and (when EMAIL_DEV_LINKS=true) are shown in the UI for local testing.
#
# Gmail example (App Password, not normal password):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=twoj@gmail.com
#   SMTP_PASS=xxxx xxxx xxxx xxxx
#   SMTP_FROM="ClipForge <twoj@gmail.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Show activation URL in API/UI when SMTP is off (default true)
EMAIL_DEV_LINKS=true

# --- Ollama (opcjonalne inteligentne przeredagowanie tekstu przy extract) ---
# Domyślnie: http://127.0.0.1:11434 , auto-wybór modelu (np. llama3.2:1b)
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2:1b
